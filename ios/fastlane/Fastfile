# TestFlight upload for Morning Guard (app + Screen Time extensions).
# Requires App Store Connect API key in CI; local runs can use the same env vars.
require "base64"
require "json"

CI_KEYCHAIN_NAME = "morning-guard-ci"
CI_APP_STORE_BUNDLE_IDS = {
  "com.morningguard.app" => "MorningGuard",
  "com.morningguard.app.monitor" => "MorningGuardMonitor",
  "com.morningguard.app.shieldconfig" => "MorningGuardShieldConfig",
  "com.morningguard.app.shieldaction" => "MorningGuardShieldAction",
}.freeze

default_platform(:ios)

def asc_api_key
  if ENV["APP_STORE_CONNECT_API_KEY_PATH"] && File.exist?(ENV["APP_STORE_CONNECT_API_KEY_PATH"])
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
      duration: 1200,
      in_house: false,
    )
  else
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true,
    )
  end
end

def ci_keychain_path
  name = ENV.fetch("MATCH_KEYCHAIN_NAME")
  raw = ENV["KEYCHAIN_PATH"].to_s
  raw = File.expand_path("~/Library/Keychains/#{name}-db") if raw.empty?
  path = File.expand_path(raw)
  path = "#{path}-db" unless path.end_with?("-db")
  path
end

def xcode_auth_xcargs
  team = ENV.fetch("IOS_DEVELOPMENT_TEAM")
  parts = [
    "DEVELOPMENT_TEAM=#{team}",
    "-allowProvisioningUpdates",
  ]
  use_api = ENV["USE_ASC_API_XCODE_AUTH"] == "1" || ENV["CI"] == "true"
  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  if use_api && key_path && File.exist?(key_path)
    parts += [
      "-authenticationKeyPath '#{key_path}'",
      "-authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_API_ISSUER_ID')}",
    ]
  end
  parts.join(" ")
end

def ci_manual_export_options(profile_map)
  {
    method: "app-store",
    signingStyle: "manual",
    signingCertificate: ENV.fetch("CI_DISTRIBUTION_IDENTITY"),
    teamID: ENV.fetch("IOS_DEVELOPMENT_TEAM"),
    provisioningProfiles: profile_map,
  }
end

def shell_quote(value)
  "'#{value.to_s.gsub("'", "'\\''")}'"
end

def unlock_ci_keychain!(keychain_path, keychain_password)
  path = shell_quote(keychain_path)
  password = shell_quote(keychain_password)
  sh("security unlock-keychain -p #{password} #{path}")
  sh("security set-keychain-settings -lut 21600 #{path}")
  sh("security default-keychain -s #{path}")
  # Login keychain on the runner has no distribution key. Leaving it in the search
  # list makes codesign wait on a GUI prompt during exportArchive.
  sh("security list-keychains -d user -s #{path}")
end

def allow_codesign_access!(keychain_path, keychain_password)
  unlock_ci_keychain!(keychain_path, keychain_password)
  sh(
    "security set-key-partition-list -S apple-tool:,apple:,codesign: -s " \
    "-k #{shell_quote(keychain_password)} #{shell_quote(keychain_path)}"
  )
end

def import_distribution_p12!(p12_path, cert_password, keychain_path, keychain_password)
  unlock_ci_keychain!(keychain_path, keychain_password)
  sh(
    "security import #{shell_quote(p12_path)} -k #{shell_quote(keychain_path)} " \
    "-P #{shell_quote(cert_password)} -f pkcs12 -T /usr/bin/codesign -T /usr/bin/security -A"
  )
  allow_codesign_access!(keychain_path, keychain_password)
end

def distribution_identity(keychain_path)
  identities = sh("security find-identity -v -p codesigning #{shell_quote(keychain_path)}", log: false)
  line = identities.lines.find { |entry| entry.include?("Apple Distribution") }
  UI.user_error!(
    "CI keychain has no Apple Distribution identity. Re-run ./scripts/push-ios-distribution-cert-secret.sh."
  ) if line.nil?

  sha1 = line[/\b([0-9A-F]{40})\b/, 1]
  name = line[/"([^"]+)"/, 1]
  UI.user_error!("Could not read the Apple Distribution certificate from the CI keychain.") if sha1.to_s.empty? || name.to_s.empty?
  ENV["CI_DISTRIBUTION_IDENTITY"] = name
  UI.success("CI signing identity: #{name}")
  sha1
end

def portal_distribution_cert_id(sha1)
  require "digest"
  certs = Spaceship::ConnectAPI::Certificate.all
  match = certs.find do |cert|
    content = cert.certificate_content.to_s
    next false if content.empty?

    Digest::SHA1.hexdigest(Base64.decode64(content)).casecmp?(sha1)
  end
  if match.nil?
    UI.important("Imported distribution certificate #{sha1} was not found in App Store Connect. sigh will pick a portal certificate.")
    return nil
  end
  UI.message("Distribution certificate #{sha1} matches portal id #{match.id}.")
  match.id
rescue StandardError => e
  UI.important("Could not match the distribution certificate in App Store Connect (#{e.message}).")
  nil
end

def profile_includes_sha1?(profile_path, sha1)
  require "openssl"
  require "digest"
  plist = sh("security cms -D -i #{shell_quote(profile_path)}", log: false)
  plist.scan(%r{<data>(.*?)</data>}m).any? do |(data)|
    der = Base64.decode64(data)
    cert = OpenSSL::X509::Certificate.new(der)
    Digest::SHA1.hexdigest(cert.to_der).casecmp?(sha1)
  rescue StandardError
    false
  end
end

def install_app_store_profile!(api_key, bundle_id, cert_id, sha1)
  params = {
    api_key: api_key,
    app_identifier: bundle_id,
    skip_install: false,
    platform: "ios",
  }
  params[:cert_id] = cert_id if cert_id

  begin
    sigh(**params, readonly: true)
  rescue StandardError => e
    UI.important("No App Store profile for #{bundle_id} (#{e.message}). Creating one.")
    sigh(**params, force: true)
  end

  profile_path = Actions.lane_context[SharedValues::SIGH_PROFILE_PATH]
  if sha1 && profile_path && !profile_includes_sha1?(profile_path, sha1)
    UI.important("Profile for #{bundle_id} does not include the CI distribution certificate. Regenerating.")
    sigh(**params, force: true)
    profile_path = Actions.lane_context[SharedValues::SIGH_PROFILE_PATH]
    if profile_path && !profile_includes_sha1?(profile_path, sha1)
      UI.user_error!(
        "App Store profile for #{bundle_id} still does not include certificate #{sha1}. " \
        "Revoke extra Apple Distribution certificates, then re-export the .p12 from the one that remains."
      )
    end
  end

  name = Actions.lane_context[SharedValues::SIGH_NAME].to_s
  UI.user_error!("sigh did not return a profile name for #{bundle_id}") if name.empty?
  name
end

def fetch_ci_app_store_profiles!(api_key, sha1)
  cert_id = portal_distribution_cert_id(sha1)
  profile_map = {}
  CI_APP_STORE_BUNDLE_IDS.each_key do |bundle_id|
    profile_map[bundle_id] = install_app_store_profile!(api_key, bundle_id, cert_id, sha1)
  end
  ENV["CI_EXPORT_PROFILES"] = JSON.generate(profile_map)
  UI.success("Export profiles: #{profile_map.values.join(', ')}")
  profile_map
end

def apply_manual_signing!(profile_map)
  team = ENV.fetch("IOS_DEVELOPMENT_TEAM")
  profile_map.each do |bundle_id, profile_name|
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "MorningGuard.xcodeproj",
      team_id: team,
      code_sign_identity: ENV.fetch("CI_DISTRIBUTION_IDENTITY"),
      targets: [CI_APP_STORE_BUNDLE_IDS.fetch(bundle_id)],
      profile_name: profile_name,
      build_configurations: ["Release"],
    )
  end
end

def prepare_ci_signing(api_key)
  return unless ENV["CI"] == "true"

  # setup_ci creates the keychain with password "" and then codesign blocks on a GUI prompt.
  keychain_password = ENV.fetch("MATCH_KEYCHAIN_PASSWORD")
  UI.user_error!("MATCH_KEYCHAIN_PASSWORD is empty.") if keychain_password.empty?
  ENV["MATCH_KEYCHAIN_NAME"] = CI_KEYCHAIN_NAME
  ENV["MATCH_KEYCHAIN_PASSWORD"] = keychain_password
  ENV["CI_KEYCHAIN_PASSWORD"] = keychain_password

  create_keychain(
    name: CI_KEYCHAIN_NAME,
    password: keychain_password,
    default_keychain: true,
    unlock: true,
    timeout: 21600,
    lock_when_sleeps: false,
    add_to_search_list: true,
  )

  p12_b64 = ENV["IOS_DISTRIBUTION_CERTIFICATE_P12"]&.gsub(/\s+/, "")
  UI.user_error!(
    "Set GitHub secrets IOS_DISTRIBUTION_CERTIFICATE_P12 and IOS_DISTRIBUTION_CERTIFICATE_PASSWORD " \
    "(run ./scripts/push-ios-distribution-cert-secret.sh on your Mac)."
  ) if p12_b64.to_s.empty?

  p12_path = File.join(Dir.tmpdir, "morning-guard-distribution.p12")
  File.binwrite(p12_path, Base64.decode64(p12_b64))
  keychain_path = ci_keychain_path
  import_distribution_p12!(
    p12_path,
    ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"),
    keychain_path,
    keychain_password,
  )
  ENV["CI_KEYCHAIN_PATH"] = keychain_path

  sha1 = distribution_identity(keychain_path)
  profile_map = fetch_ci_app_store_profiles!(api_key, sha1)
  apply_manual_signing!(profile_map)
end

def refresh_ci_keychain_for_build!
  return unless ENV["CI"] == "true"

  allow_codesign_access!(ENV.fetch("CI_KEYCHAIN_PATH"), ENV.fetch("CI_KEYCHAIN_PASSWORD"))
end

def build_app_common_options
  {
    project: "MorningGuard.xcodeproj",
    scheme: "MorningGuard",
    configuration: "Release",
    export_method: "app-store",
    export_team_id: ENV.fetch("IOS_DEVELOPMENT_TEAM"),
    output_directory: "./build",
    output_name: "MorningGuard.ipa",
  }
end

# Gym forwards `xcargs` to exportArchive as well as archive.
# On a runner, `-allowProvisioningUpdates` cloud-signs (FORBIDDEN) or, if omitted after an
# automatic archive, `exportArchive` waits forever for an Apple ID dialog. Local Macs have
# that session, so the same flag returns immediately there.
def build_release_ipa!
  shared = build_app_common_options
  if ENV["CI"] == "true"
    refresh_ci_keychain_for_build!
    # Identity is set on the app and extension targets only. A command-line
    # CODE_SIGN_IDENTITY also hits Swift package bundles (swift-crypto_Crypto)
    # and the archive fails because those bundles have no team.
    build_app(
      **shared,
      export_options: ci_manual_export_options(JSON.parse(ENV.fetch("CI_EXPORT_PROFILES"))),
    )
  else
    build_app(**shared, xcargs: xcode_auth_xcargs)
  end

  # `sh` runs in ios/fastlane, so a relative ./build path does not see gym's IPA.
  ipa_path = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH].to_s
  UI.user_error!("Exported IPA not found at #{ipa_path}") unless File.exist?(ipa_path)
  sh("bash", File.expand_path("../../scripts/validate-ios-ipa-entitlements.sh", __dir__), ipa_path)
end

platform :ios do
  desc "Release archive only (no upload)"
  lane :build_release do
    api_key = asc_api_key
    prepare_ci_signing(api_key)
    refresh_ci_keychain_for_build!
    build_release_ipa!
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = asc_api_key
    prepare_ci_signing(api_key)
    refresh_ci_keychain_for_build!
    build_release_ipa!
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end
end
