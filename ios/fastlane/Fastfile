# TestFlight upload for Morning Guard (app + Screen Time extensions).
# Requires App Store Connect API key in CI; local runs can use the same env vars.
require "base64"
require "json"

default_platform(:ios)

def asc_api_key
  if ENV["APP_STORE_CONNECT_API_KEY_PATH"] && File.exist?(ENV["APP_STORE_CONNECT_API_KEY_PATH"])
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
      duration: 1200,
      in_house: false,
    )
  else
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true,
    )
  end
end

def ci_keychain_path
  name = ENV.fetch("MATCH_KEYCHAIN_NAME")
  raw = ENV["KEYCHAIN_PATH"].to_s
  raw = File.expand_path("~/Library/Keychains/#{name}-db") if raw.empty?
  path = File.expand_path(raw)
  # setup_ci sets KEYCHAIN_PATH without the "-db" suffix; the on-disk keychain is always *-db.
  path = "#{path}-db" unless path.end_with?("-db")
  path
end

def xcode_auth_xcargs
  team = ENV.fetch("IOS_DEVELOPMENT_TEAM")
  parts = [
    "DEVELOPMENT_TEAM=#{team}",
    "-allowProvisioningUpdates",
  ]
  if ENV["CI"] == "true"
    kc = ci_keychain_path.gsub("'", "'\\''")
    parts << "CODE_SIGN_KEYCHAIN='#{kc}'"
    parts << "OTHER_CODE_SIGN_FLAGS=--keychain '#{kc}'"
  end
  # GitHub Actions has no logged-in Apple ID; local Mac should use Xcode login (unsigned archives if API-only).
  use_api = ENV["USE_ASC_API_XCODE_AUTH"] == "1" || ENV["CI"] == "true"
  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  if use_api && key_path && File.exist?(key_path)
    parts += [
      "-authenticationKeyPath '#{key_path}'",
      "-authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_API_ISSUER_ID')}",
    ]
  end
  parts.join(" ")
end

def ci_export_options(profile_map)
  {
    method: "app-store",
    signingStyle: "manual",
    teamID: ENV.fetch("IOS_DEVELOPMENT_TEAM"),
    provisioningProfiles: profile_map,
  }
end

def ci_build_app_options
  profiles = ENV.fetch("CI_PROVISIONING_PROFILES")
  profile_map = JSON.parse(profiles)
  {
    export_options: ci_export_options(profile_map),
    codesigning_identity: "Apple Distribution",
  }
end

CI_RELEASE_TARGETS = {
  "MorningGuard" => "com.morningguard.app",
  "MorningGuardMonitor" => "com.morningguard.app.monitor",
  "MorningGuardShieldConfig" => "com.morningguard.app.shieldconfig",
  "MorningGuardShieldAction" => "com.morningguard.app.shieldaction",
}.freeze

def unlock_ci_keychain!(keychain_path, keychain_password)
  escaped_pw = keychain_password.gsub("'", "'\\''")
  escaped_path = keychain_path.gsub("'", "'\\''")
  sh("security unlock-keychain -p '#{escaped_pw}' '#{escaped_path}'")
  # Keep the temp keychain unlocked for long archive/sign steps (default timeout is short).
  sh("security set-keychain-settings -lut 21600 '#{escaped_path}'")
  sh("security default-keychain -s '#{escaped_path}'")
  original = Actions.lane_context[SharedValues::ORIGINAL_DEFAULT_KEYCHAIN]
  if original.to_s.empty?
    sh("security list-keychains -d user -s '#{escaped_path}'")
  else
    escaped_original = original.gsub("'", "'\\''")
    sh("security list-keychains -d user -s '#{escaped_path}' '#{escaped_original}'")
  end
end

def import_distribution_p12!(p12_path, cert_password, keychain_path, keychain_password)
  unlock_ci_keychain!(keychain_path, keychain_password)
  escaped_cert_pw = cert_password.gsub("'", "'\\''")
  escaped_path = keychain_path.gsub("'", "'\\''")
  escaped_p12 = p12_path.gsub("'", "'\\''")
  # -A / -T codesign: headless CI cannot click keychain prompts; partition-list on the keychain often fails on GHA macOS.
  sh(
    "security import '#{escaped_p12}' -k '#{escaped_path}' -P '#{escaped_cert_pw}' -f pkcs12 " \
    "-T /usr/bin/codesign -T /usr/bin/security -A"
  )
end

def prepare_ci_signing(_api_key)
  return unless ENV["CI"] == "true"

  keychain_password = ENV["MATCH_KEYCHAIN_PASSWORD"]
  UI.user_error!("MATCH_KEYCHAIN_PASSWORD must be set on CI") if keychain_password.to_s.empty?

  setup_ci

  p12_b64 = ENV["IOS_DISTRIBUTION_CERTIFICATE_P12"]&.gsub(/\s+/, "")
  UI.user_error!(
    "Set GitHub secrets IOS_DISTRIBUTION_CERTIFICATE_P12 and IOS_DISTRIBUTION_CERTIFICATE_PASSWORD " \
    "(run ./scripts/push-ios-distribution-cert-secret.sh on your Mac). " \
    "Do not use cert() on CI — it creates orphan Distribution certs."
  ) if p12_b64.to_s.empty?

  p12_path = File.join(Dir.tmpdir, "morning-guard-distribution.p12")
  File.binwrite(p12_path, Base64.decode64(p12_b64))
  keychain_path = ci_keychain_path
  profile_map = {}
  import_distribution_p12!(
    p12_path,
    ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"),
    keychain_path,
    keychain_password,
  )
  identities = sh("security find-identity -v -p codesigning '#{keychain_path.gsub("'", "'\\''")}'", log: false)
  unless identities.include?("Apple Distribution")
    UI.user_error!(
      "CI keychain has no Apple Distribution identity. The GitHub secret likely contains a Development .p12. " \
      "Re-run ./scripts/push-ios-distribution-cert-secret.sh (exports only Apple Distribution)."
    )
  end

  # Headless CI has no Xcode Apple ID. Automatic signing stays on "development"; use manual
  # App Store profiles from sigh + update_code_signing_settings for Release only.
  CI_RELEASE_TARGETS.each do |target_name, bundle_id|
    sigh(
      api_key: _api_key,
      app_identifier: bundle_id,
      skip_install: false,
      readonly: true,
    )
    profile_uuid = Actions.lane_context[SharedValues::SIGH_UUID]
    profile_map[bundle_id] = profile_uuid
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "MorningGuard.xcodeproj",
      targets: [target_name],
      profile_uuid: profile_uuid,
      team_id: ENV.fetch("IOS_DEVELOPMENT_TEAM"),
      code_sign_identity: "Apple Distribution",
      build_configurations: ["Release"],
    )
  end
  ENV["CI_PROVISIONING_PROFILES"] = JSON.generate(profile_map)
  ENV["CI_KEYCHAIN_PATH"] = keychain_path
end

def refresh_ci_keychain_for_build!
  return unless ENV["CI"] == "true"

  unlock_ci_keychain!(ENV.fetch("CI_KEYCHAIN_PATH"), ENV.fetch("MATCH_KEYCHAIN_PASSWORD"))
end

platform :ios do
  # CI runs generate-xcodeproj, sync-ios-version, and CI.xcconfig before fastlane.
  # For local `fastlane beta`, run those from the repo root first (see docs/ios/testflight.md).

  desc "Release archive only (no upload)"
  lane :build_release do
    api_key = asc_api_key
    prepare_ci_signing(api_key)
    refresh_ci_keychain_for_build!
    build_app(
      project: "MorningGuard.xcodeproj",
      scheme: "MorningGuard",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: ENV.fetch("IOS_DEVELOPMENT_TEAM"),
      xcargs: xcode_auth_xcargs,
      output_directory: "./build",
      output_name: "MorningGuard.ipa",
      **(ENV["CI"] == "true" ? ci_build_app_options : {}),
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = asc_api_key
    prepare_ci_signing(api_key)
    refresh_ci_keychain_for_build!
    build_app(
      project: "MorningGuard.xcodeproj",
      scheme: "MorningGuard",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: ENV.fetch("IOS_DEVELOPMENT_TEAM"),
      xcargs: xcode_auth_xcargs,
      output_directory: "./build",
      output_name: "MorningGuard.ipa",
      **(ENV["CI"] == "true" ? ci_build_app_options : {}),
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end
end
