# TestFlight upload for Morning Guard (app + Screen Time extensions).
# Requires App Store Connect API key in CI; local runs can use the same env vars.
default_platform(:ios)

def asc_api_key
  if ENV["APP_STORE_CONNECT_API_KEY_PATH"] && File.exist?(ENV["APP_STORE_CONNECT_API_KEY_PATH"])
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
      duration: 1200,
      in_house: false,
    )
  else
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true,
    )
  end
end

def xcode_auth_xcargs
  team = ENV.fetch("IOS_DEVELOPMENT_TEAM")
  parts = [
    "DEVELOPMENT_TEAM=#{team}",
    "-allowProvisioningUpdates",
  ]
  # GitHub Actions has no logged-in Apple ID; local Mac should use Xcode login (unsigned archives if API-only).
  use_api = ENV["USE_ASC_API_XCODE_AUTH"] == "1" || ENV["CI"] == "true"
  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  if use_api && key_path && File.exist?(key_path)
    parts += [
      "-authenticationKeyPath '#{key_path}'",
      "-authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_API_ISSUER_ID')}",
    ]
  end
  parts.join(" ")
end

APP_STORE_BUNDLE_IDS = [
  "com.morningguard.app",
  "com.morningguard.app.monitor",
  "com.morningguard.app.shieldconfig",
  "com.morningguard.app.shieldaction",
].freeze

def prepare_ci_signing(api_key)
  return unless ENV["CI"] == "true"

  setup_ci
  get_certificates(
    api_key: api_key,
    development: false,
    force: false,
  )
  APP_STORE_BUNDLE_IDS.each do |app_id|
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: app_id,
      adhoc: false,
      development: false,
      force: false,
    )
  end
end

platform :ios do
  # CI runs generate-xcodeproj, sync-ios-version, and CI.xcconfig before fastlane.
  # For local `fastlane beta`, run those from the repo root first (see docs/ios/testflight.md).

  desc "Release archive only (no upload)"
  lane :build_release do
    api_key = asc_api_key
    prepare_ci_signing(api_key)
    build_app(
      project: "MorningGuard.xcodeproj",
      scheme: "MorningGuard",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: ENV.fetch("IOS_DEVELOPMENT_TEAM"),
      xcargs: xcode_auth_xcargs,
      output_directory: "./build",
      output_name: "MorningGuard.ipa",
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = asc_api_key
    prepare_ci_signing(api_key)
    build_app(
      project: "MorningGuard.xcodeproj",
      scheme: "MorningGuard",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: ENV.fetch("IOS_DEVELOPMENT_TEAM"),
      xcargs: xcode_auth_xcargs,
      output_directory: "./build",
      output_name: "MorningGuard.ipa",
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end
end
