// Copy to Local.xcconfig (gitignored) and set your Apple Developer Team ID.
// Find Team ID: developer.apple.com/account → Membership details, or Xcode → Settings → Accounts.
//
// DEVELOPMENT_TEAM = ABCDE12345
//
// App Store Connect API (for ./scripts/ios-testflight-local.sh — gitignored; not as sensitive as the .p8 file)
// Issuer ID: App Store Connect → Users and Access → Integrations (top of page)
// Key ID: matches AuthKey_<KEY_ID>.p8 filename (optional if key lives under ~/Keys/morning-guard/)
// APP_STORE_CONNECT_API_ISSUER_ID = xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
// APP_STORE_CONNECT_API_KEY_ID = XXXXXXXXXX
//
// Bible proxy (same as Android local.properties — see workers/bible-cache/README.md)
// xcconfig treats "//" in URLs as a comment — use https:/$()/ instead of https://
// BIBLE_PROXY_BASE_URL = https:/$()/morning-guard-bible-cache.your-subdomain.workers.dev
// Licensed translations use App Attest on device (no proxy token in the app).
//
// Cloud sync (same values as Android local.properties SUPABASE_* — never commit real keys)
// SUPABASE_URL = https:/$()/your-project.supabase.co
// SUPABASE_ANON_KEY = your-anon-or-publishable-key
//
// Crash reporting (optional — leave empty to disable Sentry in local builds)
// SENTRY_DSN = https:/$()/examplePublicKey@o0.ingest.sentry.io/0
